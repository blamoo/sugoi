# systemd unit for sugoi.
#
# Adjust User/Group and the /opt/sugoi paths to your installation: the
# directory holding the binary, config/, db/, cache/, templates/, pages/ and
# static/. If config/sugoi.json sets DatabaseDir or CacheDir elsewhere, list
# those directories in ReadWritePaths instead.
#
# Install:  cp sugoi.service /etc/systemd/system/ && systemctl daemon-reload
#           systemctl enable --now sugoi
# Logs:     journalctl -u sugoi
# Sandbox:  systemd-analyze security sugoi

[Unit]
Description=sugoi
After=network-online.target
Wants=network-online.target

[Service]
User=sugoi
Group=sugoi
Type=simple
WorkingDirectory=/opt/sugoi
ExecStart=/opt/sugoi/sugoi
Restart=on-failure
RestartSec=5s
# graceful shutdown: up to 10s for in-flight requests + 30s to cancel a reindex
TimeoutStopSec=60
UMask=0027

# Sandboxing: the whole filesystem is read-only except db/ and cache/, so the
# library directories (DirVars) only need to be readable by User.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/sugoi/db /opt/sugoi/cache
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# To listen on a port below 1024 (e.g. 80), use instead:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
